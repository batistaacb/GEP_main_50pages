%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% TikZ Styles
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tikzset{
    card/.style={
        draw=PrimaryBlue,
        fill=white,
        rounded corners=8pt,
        line width=0.8pt,
        minimum width=3.6cm,
        minimum height=1.2cm,
        align=center,
        blur shadow={shadow blur steps=5}
    },
    bluebox/.style={
        draw=PrimaryBlue,
        fill=BlueCard,
        rounded corners=10pt,
        line width=1pt,
        inner sep=8pt
    },
    greenbox/.style={
        draw=PrimaryGreen,
        fill=GreenCard,
        rounded corners=10pt,
        line width=1pt,
        inner sep=8pt
    },
    redbox/.style={
        draw=PrimaryRed,
        fill=RedCard,
        rounded corners=10pt,
        line width=1pt,
        inner sep=8pt
    },
    goldbox/.style={
        draw=PrimaryGold,
        fill=GoldCard,
        rounded corners=10pt,
        line width=1pt,
        inner sep=8pt
    },
    arrow/.style={
        ->,
        >=Stealth,
        draw=ArrowColor,
        line width=1.1pt
    },
    takeaway/.style={
        draw=PrimaryBlue,
        fill=BlueCard,
        rounded corners=12pt,
        line width=1pt,
        minimum width=11cm,
        minimum height=1.4cm,
        align=center,
        font=\large
    },
    statussuccess/.style={
        draw=SuccessColor,
        fill=GreenCard,
        rounded corners=10pt,
        minimum height=0.5cm,
        inner sep=3pt,
        font=\bfseries\footnotesize,
        text=SuccessColor
    },
    statusinfo/.style={
        draw=InfoColor,
        fill=BlueCard,
        rounded corners=10pt,
        minimum height=0.5cm,
        inner sep=3pt,
        font=\bfseries\footnotesize,
        text=InfoColor
    },
    statuswarning/.style={
        draw=WarningColor,
        fill=GoldCard,
        rounded corners=10pt,
        minimum height=0.5cm,
        inner sep=3pt,
        font=\bfseries\footnotesize,
        text=WarningColor
    }
}

